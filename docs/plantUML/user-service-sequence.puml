
@startuml User Service Sequence Diagram
!theme plain
skinparam responseMessageBelowArrow true

title User Service — Sequence Diagram

actor Client
participant "API Gateway" as GW
participant "User Service" as US
database "Firestore" as FS
participant "Firebase Auth" as FA
participant "SMTP" as SMTP

== Register (POST /users) ==

Client -> GW: POST /users {username, email, password}
GW -> US: Forward (public route, no auth)
US -> FS: Check username & email uniqueness
FS --> US: Result
US -> FA: create_user(email, password)
FA --> US: uid
US -> FA: set_custom_claims(uid, role="User")
US -> FA: generate_email_verification_link(email)
FA --> US: verification_url
US -> SMTP: Send verification email
US -> FS: Store user profile (uid, username, email, role)
US --> Client: 200 {user_id, username, email, role}

== Login ==

Client -> GW: GET /users/lookup/{username}
GW -> US: Forward (public route)
US -> FS: Find user by username
US --> Client: 200 {email}
Client -> FA: signInWithEmailAndPassword(email, password)
FA --> Client: ID Token (JWT)
Client -> GW: GET /users/{uid}\nAuthorization: Bearer <token>
GW -> FA: verify_id_token(token)
FA --> GW: {uid, role}
GW -> US: GET /users/{uid}\nX-User-Id, X-User-Role headers
US -> FS: Get user document
US --> Client: 200 {user profile}

== Update Profile (PATCH /users/{id}) ==

Client -> GW: PATCH /users/{id}\nAuthorization: Bearer <token>\n{username?, avatar_id?, password?}
GW -> FA: verify_id_token(token)
GW -> US: Forward with X-User-Id header
US -> US: Check X-User-Id == path id

opt Username change
    US -> FS: Check username uniqueness
end

opt Password change
    US -> FA: update_user(uid, password)
end

US -> FS: Update user document
US --> Client: 200 "Profile updated"

== Delete Account (DELETE /users/{id}) ==

Client -> GW: DELETE /users/{id}\nAuthorization: Bearer <token>
GW -> FA: verify_id_token(token)
GW -> US: Forward with X-User-Id header
US -> US: Check X-User-Id == path id
US -> FS: Get user (check not Root)
US -> FA: delete_user(uid)
US -> FS: Delete user document
US --> Client: 200 "User deleted"

== Admin: Get All Users (GET /admin/users) ==

Client -> GW: GET /admin/users\nAuthorization: Bearer <token>
GW -> FA: verify_id_token(token)
GW -> US: Forward with X-User-Role header
US -> US: Verify role is admin/root
US -> FS: Stream all users
US --> Client: 200 [users]

== Admin: Delete User (DELETE /admin/users/{id}) ==

Client -> GW: DELETE /admin/users/{id}\nAuthorization: Bearer <token>
GW -> FA: verify_id_token(token)
GW -> US: Forward with X-User-Role header
US -> US: Verify role is admin/root
US -> FS: Get user (check not Root)
US -> FA: delete_user(uid)
US -> FS: Delete user document
US --> Client: 200 "User deleted"

== Admin: Promote User (POST /admin/promote/{id}) ==

Client -> GW: POST /admin/promote/{id}\nAuthorization: Bearer <token>
GW -> FA: verify_id_token(token)
GW -> US: Forward with X-User-Role header
US -> US: Verify role is admin/root
US -> FS: Get user, check current role
US -> FS: Update role to "Admin"
US -> FA: set_custom_claims(uid, role="Admin")
US --> Client: 200 "User promoted"

@enduml
