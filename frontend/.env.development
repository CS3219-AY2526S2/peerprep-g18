# Local development environment variables for Vite.
# These are used when running `npm run dev` locally.
# VITE_GATEWAY_URL: Points to nginx on port 80, which strips /api/ and proxies to api-gateway:1234.
# VITE_ALB_URL: Points to nginx on port 80, which proxies /socket.io/ to collab-service:4000.
VITE_GATEWAY_URL=http://localhost/api
VITE_ALB_URL=http://localhost
