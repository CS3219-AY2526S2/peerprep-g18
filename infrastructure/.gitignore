# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.log.*

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# .tfvars.example files should be committed as they contain only dummy data.
!*.tfvars.example

# .terraform.lock.hcl is usually committed to lock provider versions.
# .terraform.lock.hcl

# Ignore AWS credential files
.aws/
credentials
